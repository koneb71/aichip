    "text": "@Frontend ship it using @release-checklist",
    "expect": [
      "Frontend",
      "release-checklist"
    ]
  },
  {
    "why": "a skill name with hyphens is one name, not a name and a word",
    "agents": [
      "release-checklist"
    ],
    "text": "@release-checklist please",
    "expect": [
      "release-checklist"
    ]
  },
  {
    "why": "longest-first still holds across the two kinds",
    "agents": [
